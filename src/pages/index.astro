---
import BaseLayout from '../layout/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout>
	<main>
		<Header />
	</main>
</BaseLayout>

<style>
	main {
		display: grid;
		min-height: 100svh;
		align-items: start;
		justify-items: start;
		padding: 1.5rem clamp(1.5rem, 8vw, 8rem);
		background: #fff;
	}
</style>
