---
import heroImage from '../../../image/hero.png';
---

<section id="hero" class="hero">
	<div class="content">
		<h1>Welcome to Bstrap</h1>
	</div>
	<figure class="image-frame">
		<img src={heroImage.src} alt="Two friends smiling together" />
		<figcaption>Bstrap, made for your everyday</figcaption>
	</figure>
	<div class="footer">
		<a href="#projects">Explore Carry<span aria-hidden="true">↓</span></a>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.78fr);
		grid-template-rows: 1fr auto;
		align-items: center;
		column-gap: clamp(2.5rem, 7vw, 7rem);
		min-height: calc(100svh - 105px);
		padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 8vw, 8rem) 2.5rem;
		background: #f3f1eb;
		scroll-margin-top: 2rem;
	}
	.content {
		grid-column: 1;
		grid-row: 1;
	}
	h1 {
		max-width: 750px;
		margin: 0;
		font-size: clamp(3.5rem, 8.5vw, 8.5rem);
		line-height: 0.88;
		letter-spacing: -0.075em;
	}
	.image-frame {
		width: min(100%, 480px);
		margin: 0 0 1.5rem auto;
		padding: 0.65rem;
		border: 1px solid #171717;
		background: #fff;
		box-shadow: 12px 12px 0 #c6c6b5;
	}
	.image-frame img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		border: 1px solid #d8d7d0;
		object-fit: cover;
		object-position: center 45%;
	}
	.image-frame figcaption {
		padding: 0.8rem 0.25rem 0.1rem;
		color: #62625c;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		grid-column: 1 / -1;
		grid-row: 2;
		padding-top: 2rem;
		border-top: 1px solid #d8d7d0;
	}
	.footer p,
	.footer a {
		margin: 0;
		color: #62625c;
		font-size: 0.95rem;
	}
	.footer a {
		display: inline-flex;
		gap: 0.75rem;
		color: #171717;
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: auto auto auto;
			row-gap: 2.5rem;
			min-height: auto;
		}
		h1 {
			font-size: clamp(3.2rem, 16vw, 5.2rem);
		}
		.image-frame {
			grid-column: 1;
			grid-row: 2;
			width: min(82%, 420px);
			margin: 0 auto 0.75rem;
		}
		.footer {
			align-items: flex-start;
			grid-column: 1;
			grid-row: 3;
		}
	}
</style>
