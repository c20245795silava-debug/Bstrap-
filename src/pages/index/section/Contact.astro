---
import contactImage from '../../../image/contact.png';
---

<section id="contact" class="contact">
	<div>
		<div class="eyebrow">Partner with us</div>
		<h2>Let's build<br />Bstrap.</h2>
	</div>
	<figure class="image-frame">
		<img src={contactImage.src} alt="Two friends smiling together" />
		<figcaption>WOW!!! NAMAN!!!!</figcaption>
	</figure>
	<div class="details">
		<p>Order or ask us anything.</p>
		<form action="mailto:hello@bstarp.com" method="post" enctype="text/plain">
			<label for="contact-name">Name</label>
			<input id="contact-name" name="name" type="text" placeholder="Your name" required />

			<label for="contact-email">Email</label>
			<input id="contact-email" name="email" type="email" placeholder="you@example.com" required />

			<label for="contact-message">Message</label>
			<textarea id="contact-message" name="message" rows="4" placeholder="Tell us what you need" required></textarea>

			<button type="submit">Send message <span aria-hidden="true">↗</span></button>
		</form>
	</div>
</section>

<style>
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(190px, 0.75fr) minmax(260px, 1fr);
		align-items: start;
		gap: clamp(1.5rem, 4vw, 4rem);
		padding: clamp(4.5rem, 9vw, 8.5rem) clamp(1.5rem, 8vw, 8rem);
		background: #171717;
		color: #fff;
		scroll-margin-top: 2rem;
	}
	.image-frame {
		width: min(100%, 360px);
		margin: 0 auto 0.75rem;
		padding: 0.65rem;
		border: 1px solid #d8d7d0;
		background: #fff;
		box-shadow: 12px 12px 0 #77776f;
	}
	.image-frame img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		border: 1px solid #d8d7d0;
		object-fit: cover;
		object-position: center 45%;
	}
	.image-frame figcaption {
		padding: 0.8rem 0.25rem 0.1rem;
		color: #62625c;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.eyebrow {
		margin-bottom: 1.25rem;
		color: #aaa9a2;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0;
		font-size: clamp(3.25rem, 7vw, 7rem);
		line-height: 0.92;
		letter-spacing: -0.06em;
	}
	p {
		margin: 0 0 2rem;
		color: #bcbcb5;
		line-height: 1.65;
	}
	form {
		display: grid;
		gap: 0.75rem;
	}
	label {
		color: #d7d7d0;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	input,
	textarea {
		width: 100%;
		margin-bottom: 0.35rem;
		padding: 0.85rem 0;
		border: 0;
		border-bottom: 1px solid #66665f;
		border-radius: 0;
		outline: none;
		background: transparent;
		color: #fff;
		font: inherit;
	}
	textarea {
		resize: vertical;
	}
	input::placeholder,
	textarea::placeholder {
		color: #92928b;
	}
	input:focus,
	textarea:focus {
		outline: none;
		border-bottom-color: #fff;
	}
	button {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		margin-top: 0.75rem;
		padding: 1rem 1.25rem;
		border: 0;
		background: #fff;
		color: #171717;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	button:hover {
		background: #e8e8e1;
	}
	@media (max-width: 780px) {
		.contact {
			grid-template-columns: 1fr;
		}
		.image-frame {
			width: min(82%, 420px);
		}
		h2 {
			font-size: clamp(3.25rem, 14vw, 5.5rem);
		}
	}
</style>
