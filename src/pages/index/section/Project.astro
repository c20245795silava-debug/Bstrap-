---
const products = [
	{ number: '01', name: 'Bstarp Office', category: 'Slim carry for work and school', image: '/bstarp-bag.png', color: '#d7dbca' },
	{ number: '02', name: 'Bstrap Pocket', category: 'Phone, wallet, keys, go', image: '/bstarp-city-pack.jpg', color: '#d8c7bd' },
	{ number: '03', name: 'Bstarp Field', category: 'Room for the whole day', image: '/bstarp-city-pack-third.png', color: '#c7d3d6' },
];
---

<section id="projects" class="projects">
	<div class="heading">
		<div>
			<div class="eyebrow">Our first product</div>
			<h2>The collection</h2>
		</div>
		<p>A compact bag system built for work, city travel, and everyday movement.</p>
	</div>
	<div class="grid">
		{products.map((product) => (
			<article>
				<div class="preview" style={`--preview-color: ${product.color}`}>
					<img src={product.image} alt={product.name} />
					<span>{product.number}</span>
				</div>
				<h3>{product.name}</h3>
				<p>{product.category}</p>
			</article>
		))}
	</div>
</section>

<style>
	.projects {
		padding: clamp(4.5rem, 9vw, 8.5rem) clamp(1.5rem, 8vw, 8rem);
		background: #f3f1eb;
		scroll-margin-top: 2rem;
	}
	.heading {
		display: grid;
		grid-template-columns: 1fr minmax(250px, 390px);
		align-items: end;
		gap: 2rem;
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}
	.eyebrow {
		margin-bottom: 1.25rem;
		color: #77776f;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0;
		font-size: clamp(3.25rem, 7vw, 6.5rem);
		line-height: 0.9;
		letter-spacing: -0.06em;
	}
	.heading > p {
		margin: 0;
		color: #62625c;
		font-size: 1.05rem;
		line-height: 1.65;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 2.5vw, 2rem);
	}
	.preview {
		position: relative;
		aspect-ratio: 4 / 3;
		margin-bottom: 1.25rem;
		background: var(--preview-color);
		overflow: hidden;
	}
	.preview img {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #fff;
	}
	.preview span {
		position: absolute;
		z-index: 2;
		top: 1rem;
		right: 1rem;
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid rgba(23, 23, 23, 0.35);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.9);
		place-items: center;
		font-size: 0.75rem;
	}
	h3 {
		margin: 0 0 0.35rem;
		font-size: 1.35rem;
		letter-spacing: -0.035em;
	}
	article > p {
		margin: 0;
		color: #77776f;
		font-size: 0.9rem;
	}
	@media (max-width: 780px) {
		.heading {
			grid-template-columns: 1fr;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		article {
			margin-bottom: 1.5rem;
		}
	}
</style>
